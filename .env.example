# Names only: copy only the variables your selected architecture needs.
# This file is safe to commit because all values are empty. Never paste secrets here.
# Astro PUBLIC_ variables ship to browsers; Next.js uses NEXT_PUBLIC_ instead.
PUBLIC_SITE_URL=
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
PUBLIC_TURNSTILE_SITE_KEY=
# Server runtime only; do not add PUBLIC_ or NEXT_PUBLIC_ prefixes.
SUPABASE_SECRET_KEY=
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
STRIPE_RESTRICTED_KEY=
STRIPE_WEBHOOK_SECRET=
# Prefer local OAuth for Wrangler; scope CI tokens only if CI deploy is selected.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
